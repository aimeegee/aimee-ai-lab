{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit *--visibility*)"
    ]
  }
}
